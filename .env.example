# kdp-factory environment variables
# Copy to `.env` for local use. `.env*` is gitignored (except this file).
# Do NOT commit real secrets.

# --- Anthropic (CLI pipeline) ---
ANTHROPIC_API_KEY=

# --- Landing page / billing (Stripe Payment Links) ---
# Stripe ダッシュボードで作成した Payment Link の URL を貼り付ける。
# これらは公開URLでありシークレットではないが、環境ごとに差し替えるため env 管理する。
# landing/build-config.js がこの値から landing/config.js を生成する。
STRIPE_PAYMENT_LINK_INDIVIDUAL=
STRIPE_PAYMENT_LINK_CORPORATE=
